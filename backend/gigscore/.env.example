# Copy this file to .env (or set these in your shell/IDE run configuration)

DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=your_long_random_jwt_secret
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hibernate schema handling: update (local dev) or validate (prod)
DDL_AUTO=update
# Optional: seed a demo LENDER account (blank = skip; endpoint: GET /api/v1/lender/workers)
DEMO_LENDER_EMAIL=demo_lender@example.com
DEMO_LENDER_PASSWORD=change_me_please
