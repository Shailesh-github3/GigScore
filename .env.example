# Database Configuration
# Set your MySQL root/user password. Do NOT use default or weak passwords.
DB_USERNAME=root
DB_PASSWORD=

# JWT Authentication
# Secret key used for signing HMAC-SHA256 tokens. Must be at least 32 characters (256 bits).
# Generate a strong key e.g.: openssl rand -base64 32
JWT_SECRET=

# Google Gemini AI Integration (Optional)
# API key for Gemini chat insights. Leave empty if not using live AI insights.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Demo Lender Account (Optional)
# Credentials to seed a demo lender user on startup. Leave empty to skip.
DEMO_LENDER_EMAIL=
DEMO_LENDER_PASSWORD=

# Application & CORS Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DDL_AUTO=update
VITE_API_URL=http://127.0.0.1:8080
